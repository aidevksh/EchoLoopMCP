# --- Pick ONE channel. EchoLoop uses whichever credentials are present. ---

# Telegram (two-way: notify + ask)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (two-way: notify + ask)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Discord (one-way: notify only)
DISCORD_WEBHOOK_URL=

# Optional
# ECHOLOOP_CHANNEL=telegram   # force a channel when both are configured
# ECHOLOOP_TIMEOUT=240        # default `ask` wait, in seconds
